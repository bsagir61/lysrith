        { "text": "Discard the cluster.", "effects": { "rival_momentum": 3 }, "note": "+3 Rival Momentum" },
        { "text": "Feed it false interest.", "effects": { "heat": 6, "rival_momentum": -4 }, "note": "+6 Heat, -4 Rival Momentum" }
      ]
    },
    {
