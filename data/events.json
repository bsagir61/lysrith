{
  "events": [
    {
      "id": "leaked_briefing", "title": "Leaked Briefing", "tone": "pressure",
      "desc": "A summary of Directorate activity surfaces in an open forum. It is vague, but it is ours.",
      "trigger": { "type": "heat_min", "value": 25 },
      "choices": [
        { "text": "Deny everything, publicly.", "effects": { "heat": -8, "trust": -6 }, "note": "-8 Heat, -6 Trust" },
        { "text": "Say nothing. Let it fade.", "effects": { "global_exposure": 5 }, "note": "+5 Global Exposure" },
        { "text": "Spend Intel to trace the leak.", "effects": { "intel": -8, "heat": -12 }, "note": "-8 Intel, -12 Heat" }
      ]
    },
    {
      "id": "unstable_contact", "title": "Unstable Contact", "tone": "internal",
      "desc": "A local source demands double payment and hints they have other buyers.",
      "trigger": { "type": "turn_min", "value": 3 },
      "choices": [
        { "text": "Pay them off.", "effects": { "funds": -15 }, "note": "-15 Funds" },
        { "text": "Cut them loose.", "effects": { "region_rival": 8, "heat": 4 }, "note": "+Rival Influence in one region, +4 Heat" }
      ]
    },
    {
      "id": "false_pattern", "title": "False Pattern", "tone": "rival",
