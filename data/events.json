      "choices": [
        { "text": "Full transparency.", "effects": { "trust": 8, "funds": -10 }, "note": "+8 Trust, -10 Funds" },
        { "text": "Creative accounting.", "effects": { "funds": 15, "trust": -8 }, "note": "+15 Funds, -8 Trust" }
      ]
    },
    {
